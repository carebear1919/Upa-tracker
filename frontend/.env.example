# Copy this file to .env and fill in your Supabase project's values
# (Project Settings → API in the Supabase dashboard). Without these, the app
# falls back to storing everything in the browser's localStorage instead.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# One shared login every device signs into automatically (no login screen
# shown — the PIN lock is the only thing your family sees). This is what
# makes every device read/write the exact same data. Create this user once
# via Authentication → Users → Add user in the Supabase dashboard.
VITE_SUPABASE_APP_EMAIL=
VITE_SUPABASE_APP_PASSWORD=
